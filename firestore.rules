rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /movement_products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
